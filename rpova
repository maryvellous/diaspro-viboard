<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
    <defs>
        <!-- Filtro blur per il morbido -->
        <filter id="softGlow">
            <feGaussianBlur in="SourceGraphic" stdDeviation="8"/>
        </filter>
        
        <!-- Gradiente bianco/oro da destra a sinistra -->
        <linearGradient id="rightLight" x1="100%" y1="50%" x2="0%" y2="50%">
            <stop offset="0%" style="stop-color:#FFE4B5;stop-opacity:0.6"/>
            <stop offset="40%" style="stop-color:#FFF8DC;stop-opacity:0.3"/>
            <stop offset="100%" style="stop-color:#FFF8DC;stop-opacity:0"/>
        </linearGradient>
    </defs>
    
    <!-- Effetto luce che segue il contorno destro della D -->
    <path d="M 70 40 
             Q 115 40, 115 56
             L 115 84
             Q 115 84, 110 84
             L 110 116
             Q 115 116, 115 132
             Q 115 160, 70 160"
          fill="none" stroke="url(#rightLight)" stroke-width="20" stroke-linecap="round" filter="url(#softGlow)"/>
    
    <!-- Gruppo Icona (La "D" a Blocchi Stack) -->
    <g transform="translate(45, 0)">
        <!-- Blocco Superiore -->
        <rect x="0" y="40" width="70" height="32" rx="16" fill="#DDC4E7"/>
        <!-- Blocco Centrale (Esteso) -->
        <rect x="0" y="84" width="110" height="32" rx="16" fill="#725980"/>
        <!-- Blocco Inferiore -->
        <rect x="0" y="128" width="70" height="32" rx="16" fill="#4B1556"/>
    </g>
</svg>
